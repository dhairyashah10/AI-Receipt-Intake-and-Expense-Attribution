# Choose which LLM provider to use for extraction: "anthropic", "openai", or "mock"
# "mock" runs the full pipeline with synthetic LLM responses -- useful for testing
# the plumbing without spending any API credits.
LLM_PROVIDER=anthropic

# Only one of these needs to be set, matching LLM_PROVIDER above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model names (defaults shown; override if you want a different model)
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o

# OCR quality threshold (0-1). Below this, we fall back to sending the image
# directly to the vision-capable LLM instead of trusting the OCR text.
OCR_QUALITY_THRESHOLD=0.55
